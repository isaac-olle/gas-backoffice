# ── App ────────────────────────────────────────────────────────────────────────
ENV=development
API_PORT=8090
API_BASE_URL="http://localhost:8090"
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_ORIGINS=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_DSN="postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=disable"
MIGRATIONS_DSN="postgresql://<admin_user>:<password>@<host>:<port>/<db>?sslmode=disable"

# ── Seed ──────────────────────────────────────────────────────────────────────
SEED_TOKEN=""
SEED_ADMIN_NAME=""
SEED_SUBSCRIPTION_NAME=""
SEED_ADMIN_EMAIL=""

# ── Backoffice IDs (must match scripts/.env seed values) ──────────────────────
GAS_BACKOFFICE_PROTECTED_RESOURCE_ID=""
GAS_BACKOFFICE_OPENID_SCOPE_ID=""
GAS_BACKOFFICE_EMAIL_SCOPE_ID=""
GAS_BACKOFFICE_PROFILE_SCOPE_ID=""
GAS_BACKOFFICE_CLIENT_ID=""
GAS_BACKOFFICE_CLIENT_SECRET=""
GAS_BACKOFFICE_CLIENT_REDIRECT_URI=""
GAS_PROTOCOL_URL="http://localhost:8090"

# ── Security ──────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=""
