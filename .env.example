# ── App ────────────────────────────────────────────────────────────────────────
CONFIG_FILE_PATH=./config/config.yaml
ENV=development
API_HOST="0.0.0.0"
API_PORT=8090

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_DSN="postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=disable"
MIGRATIONS_DSN="postgresql://<admin_user>:<password>@<host>:<port>/<db>?sslmode=disable"
MIGRATIONS_PATH="./deploy/golang-migrate"

# ── Seed (auto-filled by: go run ./cmd/db_seed --env-file .env.local) ─────────
BACKOFFICE_PR_ID=""
SEED_ADMIN_ID=""
ADMIN_ASSERTION_KEY_ID=""
ADMIN_ASSERTION_PRIVATE_KEY=""
