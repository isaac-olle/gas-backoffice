{
  "admin": {
    "name": "${SEED_ADMIN_NAME}",
    "email": "${SEED_ADMIN_EMAIL}"
  },
  "subscription": {
    "name": "${SEED_SUBSCRIPTION_NAME}"
  },
  "protected_resource": {
    "id": "${GAS_BACKOFFICE_PROTECTED_RESOURCE_ID}",
    "name": "Gas Backoffice"
  },
  "scopes": [
    {
      "id": "${GAS_BACKOFFICE_OPENID_SCOPE_ID}",
      "name": "openid"
    },
    {
      "id": "${GAS_BACKOFFICE_EMAIL_SCOPE_ID}",
      "name": "email"
    },
    {
      "id": "${GAS_BACKOFFICE_PROFILE_SCOPE_ID}",
      "name": "profile"
    }
  ],
  "client": {
    "id": "${GAS_BACKOFFICE_CLIENT_ID}",
    "name": "Gas Backoffice Frontend",
    "redirect_uris": ["${GAS_BACKOFFICE_CLIENT_REDIRECT_URI}"],
    "secret": "${GAS_BACKOFFICE_CLIENT_SECRET}"
  },
  "identity_providers": [
    {
      "id": "${GOOGLE_IDP_ID}",
      "reference_name": "google",
      "name": "Google",
      "issuer": "${GOOGLE_ISSUER}",
      "client_id": "${GOOGLE_CLIENT_ID}",
      "client_secret": "${GOOGLE_CLIENT_SECRET}",
      "authorization_endpoint": "${GOOGLE_AUTHORIZATION_ENDPOINT}",
      "token_endpoint": "${GOOGLE_TOKEN_ENDPOINT}",
      "userinfo_endpoint": "${GOOGLE_USERINFO_ENDPOINT}",
      "jwks_uri": "${GOOGLE_JWKS_URI}",
      "scopes": ["openid", "email", "profile"],
      "backoffice_redirect_uri": "${BACKOFFICE_REDIRECT_URI}"
    }
  ]
}
