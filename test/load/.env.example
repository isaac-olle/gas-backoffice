# Set these as environment variables before running k6 (k6 does not load .env).
BASE_URL=http://localhost:8090
CLIENT_ID=replace-with-test-client-id
CLIENT_SECRET=replace-with-test-client-secret
REDIRECT_URI=http://localhost:3000/callback
IDP_REFERENCE_NAME=replace-with-test-provider-reference
IDP_AUTHORIZATION_URL=https://test-idp.example/authorize
AUTHORIZE_SCOPE=openid
TOKEN_SCOPE=read
SCENARIOS=authorize,client_credentials
PROFILE=smoke
# PROFILE=stress ramps each selected arrival-rate scenario independently.
BASE_RATE=5
PEAK_RATE=50
PREALLOCATED_VUS=20
MAX_VUS=100
P95_MS=500
P99_MS=1500
# Authorization code mode only; path relative to protocol.js:
# SCENARIOS=authorization_code
# AUTH_CODES_FILE=./codes.local.json
# CODE_VUS=10
